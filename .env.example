# Copy this file to .env.local and fill in real values.
# .env.local is never committed. This file holds names only, never secrets.

# Postgres. Local Docker example:
#   postgresql://postgres:postgres@localhost:5432/life_organiser
# Neon example: copy the pooled connection string from the project dashboard.
DATABASE_URL=""

# Auth.js with Google. The OAuth client is created once, in Google Cloud.
# Runbook: docs/reference/oauth-setup.md
# Variable names follow the Auth.js v5 convention. next-auth is pinned to
# 5.0.0-beta.32, so a new beta cannot change behaviour under us.
#
# Client ID. Public — it appears in the browser's address bar during sign-in.
AUTH_GOOGLE_ID=""
# Client secret. Shown once when the client is created; store it in a password
# manager as well, because the console will not show it again.
AUTH_GOOGLE_SECRET=""
# Signs our own session cookie. Unrelated to Google. Generate 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Comma-separated allowlist of exactly two addresses. Enforced in the signIn
# callback, server-side. Anything not listed is rejected.
ALLOWED_EMAILS=""
